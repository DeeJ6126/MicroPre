        },
        {
            "type": "list",
            "content": {
                "list_type": "text_list",
                "list_items": [
                    {
                        "item_type": "text",
                        "item_content": [
                            {
                                "type": "text",
                                "content": "1. 点突变是新冠进化的基础引擎"
                            }
                        ]
                    },
                    {
                        "item_type": "text",
                        "item_content": [
